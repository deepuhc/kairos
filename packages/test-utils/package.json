{
  "name": "@kairos/test-utils",
  "version": "0.1.0",
  "type": "module",
  "description": "Kairos shared test utilities, fixtures, and mocks",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairos/core": "workspace:*",
    "@kairos/providers": "workspace:*",
    "@kairos/security": "workspace:*",
    "@kairos/runtime": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^2.1.8",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
