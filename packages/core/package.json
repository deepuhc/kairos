{
  "name": "@kairos/core",
  "version": "0.1.0",
  "type": "module",
  "description": "Kairos orchestration engine — scheduler, patterns, state, gates",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./coordinator": {
      "import": "./dist/coordinator.js",
      "types": "./dist/coordinator.d.ts"
    },
    "./project-manager": {
      "import": "./dist/project-manager.js",
      "types": "./dist/project-manager.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairos/providers": "*",
    "@kairos/security": "*"
  },
  "devDependencies": {
    "@kairos/test-utils": "*",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
