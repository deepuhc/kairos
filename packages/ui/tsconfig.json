{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "useDefineForClassFields": false,
    "outDir": "dist",
    "rootDir": ".",
    "resolveJsonModule": true
  },
  "include": ["src/**/*.ts"],
  // Tests are typechecked by Vitest, which resolves its own globals and (per
  // vitest.config.ts) skips the suites covering CI-only tooling that isn't
  // present in a plain checkout. Including them here would make `tsc -b` fail on
  // those absent modules.
  "exclude": ["src/__tests__"]
}
