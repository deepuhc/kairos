{
  "name": "@kairos/cli",
  "version": "0.1.0",
  "type": "module",
  "description": "Kairos CLI — the decisive moment for agent orchestration",
  "bin": {
    "kairos": "./dist/bin.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@kairos/core": "workspace:*",
    "@kairos/providers": "workspace:*",
    "@kairos/security": "workspace:*",
    "@kairos/runtime": "workspace:*",
    "commander": "^12.1.0",
    "ink": "^5.1.0",
    "react": "^18.3.1",
    "chalk": "^5.3.0",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.12",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2"
  }
}
