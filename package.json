{
  "name": "kairos",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "start": "node packages/server/dist/main.js",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "npm run dev -w packages/server",
    "dev:ui": "npm run dev -w packages/ui",
    "kairos": "bash packages/desktop/start.sh",
    "desktop:dev": "npm run tauri:dev -w @kairos/desktop",
    "desktop:build": "npm run tauri:build -w @kairos/desktop",
    "test": "vitest",
    "test:ci": "vitest run --coverage",
    "typecheck": "tsc -b",
    "clean": "rm -rf packages/*/dist node_modules"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "concurrently": "^9.1.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "@vitest/coverage-v8": "^2.1.8"
  }
}
